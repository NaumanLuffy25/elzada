# =====================================================
# Elzada AI Admission Website – Environment Variables
# =====================================================
# Copy this file to `.env.local` and fill in the values.
# =====================================================

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM Provider (used by /api/chat) --------------------------------------
# Choose ONE of the providers below. If none is configured, the system falls
# back to the deterministic RAG-only answer generator.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Embeddings ------------------------------------------------------------
# Used by lib/embeddings.ts. Provider picks OpenAI when OPENAI_API_KEY is set,
# otherwise uses a deterministic local hash-based embedder (good for tests).
EMBEDDING_DIM=384
EMBEDDING_MODEL=text-embedding-3-small

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Elzada Institute of Technology"
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_DASHBOARD_TOKEN=change-me-please

# --- Optional --------------------------------------------------------------
LOG_LEVEL=info
EVAL_SAMPLE_SIZE=200
